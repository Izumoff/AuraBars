@echo off
setlocal

rem Usage: build.bat [x86|x64]
rem   No argument builds both architectures.
rem Each architecture builds in its own "cmd /c" subshell so vcvarsall.bat's
rem PATH/LIB/INCLUDE changes for one arch can never leak into the other.

set "TARGETS=%~1"
if "%TARGETS%"=="" set "TARGETS=x64 x86"

rem Generated once per run (not per-architecture, so x86 and x64 always
rem share the identical build number) and included by both Version.h (for
rem the About tab) and package.bat (for AuraBars.txt), so there is exactly
rem one place a build's identity comes from - never hand-edit this file.
rem
rem <build> is the local clock time at build, HHmm, 24-hour (Code Contract
rem Sec6) - e.g. 23:03 -> 2303, 09:05 -> 0905, midnight -> 0000. PowerShell's
rem HH/mm format specifiers are always exactly two digits each, so this is
rem always exactly four characters with any leading zero intact; it is
rem captured and written as a plain string the whole way through (never
rem passed through "set /a" or any other integer coercion, which would drop
rem a leading zero - "0905" becoming "905").
rem
rem This is deliberately NOT monotonic: two builds at the same clock-minute
rem (same day or different days) collide, and a later package can have a
rem numerically lower <build> than an earlier one. Both are expected and
rem are not bugs - do not add logic here or anywhere else that assumes
rem build numbers increase, and do not "correct" an apparent regression.
echo === Generating build number ===
for /f %%T in ('powershell -NoProfile -Command "Get-Date -Format HHmm"') do set "BUILDNUM=%%T"
if not defined BUILDNUM (
    echo Failed to generate build number
    exit /b 1
)
> "%~dp0src\BuildNumber.h" echo #pragma once
>> "%~dp0src\BuildNumber.h" echo // Auto-generated by build.bat on every run - do not hand-edit.
>> "%~dp0src\BuildNumber.h" echo // Local clock time at build, HHmm, 24-hour, always exactly four
>> "%~dp0src\BuildNumber.h" echo // characters with any leading zero preserved (Code Contract Sec6).
>> "%~dp0src\BuildNumber.h" echo // Deliberately not monotonic - do not "correct" this value.
>> "%~dp0src\BuildNumber.h" echo #define AURABARS_BUILD_NUMBER "%BUILDNUM%"
echo Build number: %BUILDNUM%

rem Printed here too (not only by package.bat) so the stamped version is
rem visible in plain dev-build output, not just discoverable later from a
rem packaged snapshot.
set "VERSION_RAW="
for /f "tokens=3" %%A in ('findstr /C:"#define AURABARS_VERSION_STRING" "%~dp0src\Version.h"') do set "VERSION_RAW=%%A"
set "VERSION=%VERSION_RAW:"=%"
if defined VERSION_RAW echo Stamped version: %VERSION%.%BUILDNUM%

for %%A in (%TARGETS%) do (
    echo.
    echo === Building %%A ===
    cmd /c call "%~dp0build-one.bat" %%A
    if errorlevel 1 (
        echo Build failed for %%A
        exit /b 1
    )
)

echo.
echo All builds succeeded.
