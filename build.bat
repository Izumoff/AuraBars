@echo off
setlocal

rem Usage: build.bat [x86|x64]
rem   No argument builds both architectures.
rem Each architecture builds in its own "cmd /c" subshell so vcvarsall.bat's
rem PATH/LIB/INCLUDE changes for one arch can never leak into the other.

set "TARGETS=%~1"
if "%TARGETS%"=="" set "TARGETS=x64 x86"

rem Generated once per run (not per-architecture, so x86 and x64 always
rem share the identical build number) and included by both Version.h (for
rem the About tab) and package.bat (for AuraBars.txt), so there is exactly
rem one place a build's identity comes from - never hand-edit this file.
rem
rem Monotonic counter, not a wall-clock timestamp: the previous scheme used
rem Get-Date -Format HHmm (hour+minute only), which is not collision-proof -
rem it has just 1440 possible values per day and no memory of earlier
rem builds, so two builds run at the same clock-minute on different days
rem silently produced the identical "unique" build number. This reads
rem whatever number is already in src\BuildNumber.h (0 if the file is
rem missing, e.g. a fresh checkout) and always writes back exactly one more
rem than that, so the value can never repeat as long as this file persists
rem across runs (Code Contract Sec6).
echo === Generating build number ===
for /f %%T in ('powershell -NoProfile -Command "$p='%~dp0src\BuildNumber.h'; $old=0; if (Test-Path $p) { $m = Select-String -Path $p -Pattern 'AURABARS_BUILD_NUMBER\s+.(\d+).'; if ($m) { $old = [int]$m.Matches[0].Groups[1].Value } }; ($old+1)"') do set "BUILDNUM=%%T"
if not defined BUILDNUM (
    echo Failed to generate build number
    exit /b 1
)
> "%~dp0src\BuildNumber.h" echo #pragma once
>> "%~dp0src\BuildNumber.h" echo // Auto-generated by build.bat on every run - do not hand-edit.
>> "%~dp0src\BuildNumber.h" echo // Monotonic counter: always the previous recorded value plus one, so a
>> "%~dp0src\BuildNumber.h" echo // build number can never repeat (Code Contract Sec6). Never reset or
>> "%~dp0src\BuildNumber.h" echo // hand-edit this number - whatever this file says is authoritative.
>> "%~dp0src\BuildNumber.h" echo #define AURABARS_BUILD_NUMBER "%BUILDNUM%"
echo Build number: %BUILDNUM%

rem Printed here too (not only by package.bat) so the stamped version is
rem visible in plain dev-build output, not just discoverable later from a
rem packaged snapshot.
set "VERSION_RAW="
for /f "tokens=3" %%A in ('findstr /C:"#define AURABARS_VERSION_STRING" "%~dp0src\Version.h"') do set "VERSION_RAW=%%A"
set "VERSION=%VERSION_RAW:"=%"
if defined VERSION_RAW echo Stamped version: %VERSION%.%BUILDNUM%

for %%A in (%TARGETS%) do (
    echo.
    echo === Building %%A ===
    cmd /c call "%~dp0build-one.bat" %%A
    if errorlevel 1 (
        echo Build failed for %%A
        exit /b 1
    )
)

echo.
echo All builds succeeded.
